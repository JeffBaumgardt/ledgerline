# Supabase (Project Settings → API) — same pulseboard project, ll_* tables
# https://supabase.com/dashboard/project/eigdnwwfpvdhtcyvrtnq/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://eigdnwwfpvdhtcyvrtnq.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only — never expose to the client (service role / secret key)
SUPABASE_SECRET_KEY=

# Local Supabase (pulseboard `supabase start`) example:
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_…
# SUPABASE_SECRET_KEY=sb_secret_…

# Clerk (Dashboard → API Keys)
# Email/password only — no Google/OAuth
# https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/app
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/app

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Seed + E2E: Clerk user id / email for demo data (ll_* only)
SEED_CLERK_USER_ID=
SEED_CLERK_USER_EMAIL=demo@example.com
E2E_CLERK_USER_EMAIL=
